# Connexion MongoDB (Atlas ou local)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/denlam

# Secret utilisé pour signer les JWT — change-le par une longue chaîne aléatoire
JWT_SECRET=change-moi-en-production
JWT_EXPIRES_IN=7d

# Port du serveur
PORT=4000

# Origine(s) autorisée(s) pour le CORS — plusieurs valeurs possibles,
# séparées par des virgules (utile si le port Vite change, ex. 5173 -> 5174)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Compte admin créé par `npm run seed:admin` (à lancer une seule fois)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-moi-mot-de-passe-fort
